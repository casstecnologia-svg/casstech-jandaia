---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { whatsappLink } from '@/site.config';
---

<BaseLayout title="Pagina nao encontrada | Casstech Jandaia" noindex={true} path="/404">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-glow-radial"></div>
    <div class="container-wide relative flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
      <span class="font-display text-7xl font-bold gradient-text">404</span>
      <h1 class="mt-4 text-fluid-h3 font-bold">Essa pagina nao existe</h1>
      <p class="mt-3 max-w-md text-ink-300">
        O link pode estar quebrado ou a pagina foi movida. Vamos te levar de volta.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn-primary">
          <Icon name="lucide:home" class="h-4 w-4" />
          Voltar ao inicio
        </a>
        <a href={whatsappLink} target="_blank" rel="noopener" class="btn-ghost">
          <Icon name="lucide:message-circle" class="h-4 w-4" />
          Falar no WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
