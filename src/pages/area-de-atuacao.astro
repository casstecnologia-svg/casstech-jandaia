---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site, whatsappLink, cidades } from '@/site.config';
---

<BaseLayout
  title="Área de Atuação | Assistência Técnica em Jandaia de Goiás e Região"
  description="A Casstech atende Jandaia de Goiás e cidades vizinhas com assistência técnica, soluções de TI e desenvolvimento de sistemas. Veja se atendemos a sua cidade."
  path="/area-de-atuacao"
>
  <section class="relative overflow-hidden border-b border-line bg-bg-800">
    <div class="absolute inset-0 bg-glow-radial opacity-60"></div>
    <div class="container-wide relative py-20 sm:py-24">
      <span class="eyebrow">Área de atuação</span>
      <h1 class="mt-3 max-w-3xl text-fluid-h2 font-bold">
        Atendemos Jandaia de Goiás e cidades vizinhas
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-300">
        Nossa base é Jandaia de Goiás, mas levamos nossos serviços para toda a região.
        Confira as cidades atendidas e fale com a gente.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-wide grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="text-fluid-h3 font-bold">Cidades atendidas</h2>
        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
          {cidades.map((c) => (
            <div class="flex items-center gap-2 rounded-xl border border-line bg-surface/40 px-4 py-3 text-sm text-ink-300">
              <Icon name="lucide:map-pin" class="h-4 w-4 flex-shrink-0 text-primary" />
              {c}
            </div>
          ))}
        </div>
        <p class="mt-6 text-sm text-ink-500">
          Sua cidade não está na lista? Fale com a gente pelo WhatsApp que confirmamos o atendimento.
        </p>
      </div>

      <aside class="glass h-fit rounded-2xl p-6">
        <h2 class="text-base font-semibold text-ink-100">Atendimento rápido</h2>
        <ul class="mt-4 space-y-3 text-sm text-ink-300">
          <li class="flex items-center gap-2">
            <Icon name="lucide:phone" class="h-4 w-4 text-primary" />
            {site.phoneDisplay}
          </li>
          <li class="flex items-center gap-2">
            <Icon name="lucide:instagram" class="h-4 w-4 text-primary" />
            {site.instagramHandle}
          </li>
          <li class="flex items-start gap-2">
            <Icon name="lucide:clock" class="mt-0.5 h-4 w-4 text-primary" />
            {site.openingHours}
          </li>
        </ul>
        <a href={whatsappLink} target="_blank" rel="noopener" class="btn-whatsapp mt-6 w-full">
          <Icon name="lucide:message-circle" class="h-5 w-5" />
          Chamar no WhatsApp
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>
