---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site, whatsappLink } from '@/site.config';
---

<BaseLayout
  title="Contato | Casstech Jandaia"
  description="Fale com a Casstech Jandaia pelo WhatsApp (64) 9 9513-5055, Instagram @casstech.jandaia ou pelo formulário. Assistência técnica e TI em Jandaia de Goiás e região."
  path="/contato"
>
  <section class="relative overflow-hidden border-b border-line bg-bg-800">
    <div class="absolute inset-0 bg-glow-radial opacity-60"></div>
    <div class="container-wide relative py-20 sm:py-24">
      <span class="eyebrow">Contato</span>
      <h1 class="mt-3 max-w-3xl text-fluid-h2 font-bold">Vamos resolver o seu problema</h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-300">
        A forma mais rápida de falar com a gente é pelo WhatsApp. Prefere escrever?
        Use o formulário abaixo que retornamos o quanto antes.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-wide grid gap-10 lg:grid-cols-2">
      <!-- Canais + form -->
      <div>
        <div class="grid gap-4 sm:grid-cols-2">
          <a href={whatsappLink} target="_blank" rel="noopener" class="glass rounded-2xl p-6 transition-colors hover:border-whatsapp/50">
            <Icon name="lucide:message-circle" class="h-8 w-8 text-whatsapp" />
            <h2 class="mt-4 text-base font-semibold text-ink-100">WhatsApp</h2>
            <p class="mt-1 text-sm text-ink-500">{site.phoneDisplay}</p>
          </a>
          <a href={site.instagramUrl} target="_blank" rel="noopener" class="glass rounded-2xl p-6 transition-colors hover:border-instagram/50">
            <Icon name="lucide:instagram" class="h-8 w-8 text-instagram" />
            <h2 class="mt-4 text-base font-semibold text-ink-100">Instagram</h2>
            <p class="mt-1 text-sm text-ink-500">{site.instagramHandle}</p>
          </a>
        </div>

        <form
          name="contato"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="mt-6 space-y-4"
        >
          <input type="hidden" name="form-name" value="contato" />
          <p class="hidden">
            <label>Não preencha: <input name="bot-field" /></label>
          </p>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="nome" class="mb-1.5 block text-sm text-ink-300">Nome</label>
              <input id="nome" name="nome" type="text" required
                class="w-full rounded-xl border border-line bg-surface/60 px-4 py-3 text-sm text-ink-100 placeholder:text-ink-500 focus:border-primary focus:outline-none"
                placeholder="Seu nome" />
            </div>
            <div>
              <label for="telefone" class="mb-1.5 block text-sm text-ink-300">WhatsApp / Telefone</label>
              <input id="telefone" name="telefone" type="tel" required
                class="w-full rounded-xl border border-line bg-surface/60 px-4 py-3 text-sm text-ink-100 placeholder:text-ink-500 focus:border-primary focus:outline-none"
                placeholder="(64) 9 0000-0000" />
            </div>
          </div>
          <div>
            <label for="cidade" class="mb-1.5 block text-sm text-ink-300">Cidade</label>
            <input id="cidade" name="cidade" type="text"
              class="w-full rounded-xl border border-line bg-surface/60 px-4 py-3 text-sm text-ink-100 placeholder:text-ink-500 focus:border-primary focus:outline-none"
              placeholder="Sua cidade" />
          </div>
          <div>
            <label for="mensagem" class="mb-1.5 block text-sm text-ink-300">Mensagem</label>
            <textarea id="mensagem" name="mensagem" rows="4" required
              class="w-full rounded-xl border border-line bg-surface/60 px-4 py-3 text-sm text-ink-100 placeholder:text-ink-500 focus:border-primary focus:outline-none"
              placeholder="Descreva o problema ou o que você precisa"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full">
            <Icon name="lucide:send" class="h-4 w-4" />
            Enviar mensagem
          </button>
        </form>
      </div>

      <!-- Info + mapa -->
      <aside class="space-y-6">
        <div class="glass rounded-2xl p-6">
          <h2 class="text-base font-semibold text-ink-100">Informações</h2>
          <ul class="mt-4 space-y-3 text-sm text-ink-300">
            <li class="flex items-start gap-2">
              <Icon name="lucide:map-pin" class="mt-0.5 h-4 w-4 text-primary" />
              {site.city} - {site.state}
            </li>
            <li class="flex items-start gap-2">
              <Icon name="lucide:clock" class="mt-0.5 h-4 w-4 text-primary" />
              {site.openingHours}
            </li>
            <li class="flex items-center gap-2">
              <Icon name="lucide:mail" class="h-4 w-4 text-primary" />
              {site.email}
            </li>
          </ul>
        </div>
        <div class="overflow-hidden rounded-2xl border border-line">
          <iframe
            title="Mapa de Jandaia de Goiás"
            src="https://www.google.com/maps?q=Jandaia+de+Goias+GO&output=embed"
            width="100%"
            height="320"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
