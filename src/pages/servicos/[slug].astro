---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { site, whatsappLink } from '@/site.config';

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');
  return servicos.map((s) => ({
    params: { slug: s.slug },
    props: { servico: s, todos: servicos },
  }));
}

const { servico, todos } = Astro.props;
const { Content } = await servico.render();
const d = servico.data;

const relacionados = todos
  .filter((s) => s.slug !== servico.slug && s.data.category === d.category)
  .slice(0, 3);
const fallback = todos.filter((s) => s.slug !== servico.slug).slice(0, 3);
const outros = relacionados.length ? relacionados : fallback;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.title,
  description: d.seoDescription ?? d.excerpt,
  provider: { '@id': `${site.domain}/#business` },
  areaServed: site.region,
  serviceType: d.title,
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: site.domain },
    { '@type': 'ListItem', position: 2, name: 'Serviços', item: `${site.domain}/servicos` },
    { '@type': 'ListItem', position: 3, name: d.title, item: `${site.domain}/servicos/${servico.slug}` },
  ],
};
---

<BaseLayout
  title={d.seoTitle ?? `${d.title} | Casstech Jandaia`}
  description={d.seoDescription ?? d.excerpt}
  path={`/servicos/${servico.slug}`}
  structuredData={[serviceSchema, breadcrumb]}
>
  <section class="relative overflow-hidden border-b border-line bg-bg-800">
    <div class="absolute inset-0 bg-glow-radial opacity-60"></div>
    <div class="container-wide relative py-16 sm:py-20">
      <nav class="mb-6 flex items-center gap-2 text-xs text-ink-500" aria-label="breadcrumb">
        <a href="/" class="hover:text-primary">Início</a>
        <span>/</span>
        <a href="/servicos" class="hover:text-primary">Serviços</a>
        <span>/</span>
        <span class="text-ink-300">{d.shortTitle ?? d.title}</span>
      </nav>
      <div class="flex items-start gap-4">
        <span class="grid h-14 w-14 flex-shrink-0 place-items-center rounded-2xl border border-primary/20 bg-primary/10 text-primary">
          <Icon name={d.icon} class="h-7 w-7" />
        </span>
        <div>
          <h1 class="text-fluid-h2 font-bold leading-tight">{d.title}</h1>
          <p class="mt-3 max-w-2xl text-lg text-ink-300">{d.excerpt}</p>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={whatsappLink} target="_blank" rel="noopener" class="btn-whatsapp">
          <Icon name="lucide:message-circle" class="h-5 w-5" />
          Pedir orçamento
        </a>
        <a href="/servicos" class="btn-ghost">
          <Icon name="lucide:arrow-left" class="h-4 w-4" />
          Todos os serviços
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide grid gap-12 lg:grid-cols-3">
      <article class="prose-invert lg:col-span-2">
        <div class="space-y-5 text-ink-300 [&_h2]:mt-10 [&_h2]:text-fluid-h3 [&_h2]:font-bold [&_h2]:text-ink-100 [&_ul]:mt-4 [&_ul]:space-y-2 [&_li]:list-disc [&_li]:ml-5 [&_strong]:text-ink-100 [&_a]:text-primary">
          <Content />
        </div>
      </article>

      <aside class="space-y-6">
        {d.highlights.length > 0 && (
          <div class="glass rounded-2xl p-6">
            <h2 class="text-base font-semibold text-ink-100">O que você ganha</h2>
            <ul class="mt-4 space-y-3">
              {d.highlights.map((h) => (
                <li class="flex items-start gap-3 text-sm text-ink-300">
                  <Icon name="lucide:check-circle-2" class="mt-0.5 h-5 w-5 flex-shrink-0 text-primary" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        <div class="glass rounded-2xl bg-brand-gradient p-6 text-bg-900">
          <h2 class="text-lg font-bold">Vamos resolver isso?</h2>
          <p class="mt-2 text-sm text-bg-900/80">Atendimento rápido pelo WhatsApp, sem compromisso.</p>
          <a href={whatsappLink} target="_blank" rel="noopener"
            class="mt-4 inline-flex items-center gap-2 rounded-xl bg-bg-900 px-5 py-3 text-sm font-semibold text-ink-100 hover:brightness-125">
            <Icon name="lucide:message-circle" class="h-4 w-4" />
            {site.phoneDisplay}
          </a>
        </div>
      </aside>
    </div>
  </section>

  {outros.length > 0 && (
    <section class="section bg-bg-800 pt-16">
      <div class="container-wide">
        <h2 class="text-fluid-h3 font-bold">Outros serviços</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {outros.map((s) => (
            <ServiceCard
              title={s.data.shortTitle ?? s.data.title}
              excerpt={s.data.excerpt}
              icon={s.data.icon}
              href={`/servicos/${s.slug}`}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
