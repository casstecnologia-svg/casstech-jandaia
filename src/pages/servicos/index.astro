---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { whatsappLink } from '@/site.config';

const all = (await getCollection('servicos')).sort((a, b) => a.data.order - b.data.order);

const grupos = [
  { key: 'desenvolvimento', titulo: 'Desenvolvimento de Aplicativos e Sistemas', desc: 'Solucoes digitais sob medida para o seu ramo de atuacao.' },
  { key: 'alta-complexidade', titulo: 'Servicos de Alta Complexidade', desc: 'Reparos avancados que exigem experiencia e equipamento adequado.' },
  { key: 'geral', titulo: 'Servicos Gerais', desc: 'O suporte do dia a dia para deixar tudo funcionando.' },
];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.casstechjandaia.com.br' },
    { '@type': 'ListItem', position: 2, name: 'Servicos', item: 'https://www.casstechjandaia.com.br/servicos' },
  ],
};
---

<BaseLayout
  title="Servicos de Assistencia Tecnica e TI em Jandaia de Goias"
  description="Conheca os servicos da Casstech: reparo de placa-mae, upgrade de SSD, recuperacao de dados, formatacao, redes e desenvolvimento de aplicativos e sistemas em Jandaia de Goias e regiao."
  path="/servicos"
  structuredData={breadcrumb}
>
  <section class="border-b border-line bg-bg-800">
    <div class="container-wide py-20 sm:py-24">
      <span class="eyebrow">Servicos</span>
      <h1 class="mt-3 max-w-3xl text-fluid-h2 font-bold">
        Solucoes completas em tecnologia, do hardware ao software
      </h1>
      <p class="mt-4 max-w-2xl text-ink-300">
        Reparos de alta complexidade, suporte geral, contratos corporativos de TI e
        desenvolvimento de sistemas sob medida. Tudo com a mesma autoridade tecnica.
      </p>
    </div>
  </section>

  {grupos.map((g) => {
    const itens = all.filter((s) => s.data.category === g.key);
    if (itens.length === 0) return null;
    return (
      <section class="section">
        <div class="container-wide">
          <div class="max-w-2xl">
            <h2 class="text-fluid-h3 font-bold text-ink-100">{g.titulo}</h2>
            <p class="mt-2 text-ink-500">{g.desc}</p>
          </div>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {itens.map((s) => (
              <ServiceCard
                title={s.data.shortTitle ?? s.data.title}
                excerpt={s.data.excerpt}
                icon={s.data.icon}
                href={`/servicos/${s.slug}`}
              />
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <section class="section pt-0">
    <div class="container-wide">
      <div class="glass rounded-3xl p-10 text-center">
        <h2 class="text-fluid-h3 font-bold">Nao encontrou o que precisa?</h2>
        <p class="mx-auto mt-3 max-w-xl text-ink-300">
          Chame no WhatsApp e conte a sua necessidade. Vamos encontrar a melhor solucao para voce.
        </p>
        <a href={whatsappLink} target="_blank" rel="noopener" class="btn-whatsapp mt-6">
          <Icon name="lucide:message-circle" class="h-5 w-5" />
          Falar no WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
