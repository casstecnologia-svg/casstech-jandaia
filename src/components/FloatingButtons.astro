---
import { Icon } from 'astro-icon/components';
import { whatsappLink, site } from '@/site.config';
---

<!-- Botoes flutuantes (desktop e mobile) -->
<div class="fixed bottom-5 right-5 z-40 flex flex-col items-end gap-3 print:hidden">
  <a
    href={site.instagramUrl}
    target="_blank"
    rel="noopener"
    aria-label="Instagram da Casstech"
    class="grid h-12 w-12 place-items-center rounded-full text-white shadow-lg transition-transform hover:scale-110"
    style="background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fd5949 45%, #d6249f 60%, #285AEB 90%);"
  >
    <Icon name="lucide:instagram" class="h-6 w-6" />
  </a>
  <a
    href={whatsappLink}
    target="_blank"
    rel="noopener"
    aria-label="Falar no WhatsApp"
    class="grid h-14 w-14 place-items-center rounded-full bg-whatsapp text-white shadow-lg animate-pulseRing transition-transform hover:scale-110"
  >
    <Icon name="lucide:message-circle" class="h-7 w-7" />
  </a>
</div>

<!-- Barra CTA sticky no mobile -->
<a
  href={whatsappLink}
  target="_blank"
  rel="noopener"
  class="btn-whatsapp fixed inset-x-3 bottom-3 z-30 shadow-xl sm:hidden print:hidden"
>
  <Icon name="lucide:message-circle" class="h-5 w-5" />
  Orçamento no WhatsApp
</a>
