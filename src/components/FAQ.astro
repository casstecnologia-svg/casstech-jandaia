---
import { Icon } from 'astro-icon/components';

interface Item {
  pergunta: string;
  resposta: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="mx-auto max-w-3xl divide-y divide-line rounded-2xl border border-line bg-surface/40">
  {
    items.map((item) => (
      <details class="group px-6">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left font-medium text-ink-100">
          <span>{item.pergunta}</span>
          <Icon
            name="lucide:plus"
            class="h-5 w-5 flex-shrink-0 text-primary transition-transform duration-200 group-open:rotate-45"
          />
        </summary>
        <p class="pb-5 text-sm leading-relaxed text-ink-300">{item.resposta}</p>
      </details>
    ))
  }
</div>
