---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  excerpt: string;
  icon: string;
  href: string;
}
const { title, excerpt, icon, href } = Astro.props;
---

<a href={href} class="card-service group flex flex-col">
  <span
    class="mb-5 grid h-12 w-12 place-items-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition-colors group-hover:bg-primary/20"
  >
    <Icon name={icon} class="h-6 w-6" />
  </span>
  <h3 class="text-lg font-semibold text-ink-100">{title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{excerpt}</p>
  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-primary">
    Saiba mais
    <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
  </span>
  <span
    class="pointer-events-none absolute inset-x-0 -top-px h-px bg-brand-gradient opacity-0 transition-opacity group-hover:opacity-100"
  ></span>
</a>
